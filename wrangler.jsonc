{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tampo",
  "compatibility_date": "2026-08-13",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "./worker/index.ts",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tampo-production-eu",
      "database_id": "1d784147-027b-47c1-ab03-78e5b24d73fb",
      "migrations_dir": "drizzle"
    }
  ],
  "observability": {
    "enabled": true
  },
  "cache": {
    "enabled": true
  }
}
