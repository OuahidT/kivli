{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kivli-admin",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-13",
  "workers_dev": false,
  "preview_urls": false,
  "keep_vars": true,
  "vars": {
    "ADMIN_EMAIL_V2": "contact@kivli.fr",
    "SMTP_HOST": "smtp.mail.ovh.net",
    "SMTP_PORT": "587",
    "SMTP_USERNAME": "contact@kivli.fr"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kivli-production-eu",
      "database_id": "2294e62a-ebce-4514-b440-36fbd3569363"
    }
  ]
}
